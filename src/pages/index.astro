---
import { getCollection } from 'astro:content';
import Sheet from '../layouts/Sheet.astro';
import { profile } from '../data/profile';
import ProjectTable from '../components/ProjectTable.astro';
import { STATUS_MARK, STATUS_ORDER } from '../lib/status';

// Numbering runs across both groups, in `order`, so it matches the project pages.
const numbered = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project, i) => ({ project, num: i + 1 }));
const hardware = numbered.filter((r) => r.project.data.group === 'hardware');
const software = numbered.filter((r) => r.project.data.group === 'software');
---

<Sheet title={profile.name} description={profile.description} variant="home">
  <div class="home">
    <aside class="titleblock">
      <div class="tb-cell tb-name">
        <p class="k">TITLE</p>
        <h1>Joel<br />Anthony</h1>
      </div>
      {
        profile.titleBlock.map((cell) => (
          <div class="tb-cell">
            <p class="k">{cell.label}</p>
            {cell.lines.map((line) => (
              <p class="v">{line}</p>
            ))}
          </div>
        ))
      }
      <div class="tb-cell">
        <p class="k">{profile.education.label}</p>
        <p class="v">{profile.education.primary}</p>
        <p class="v-sub">{profile.education.secondary}</p>
      </div>
      <div class="tb-cell tb-links">
        <p class="k">CONTACT</p>
        {profile.contact.map((c) => <a href={c.href}>{c.text}</a>)}
      </div>
    </aside>

    <main class="home-main">
      <section class="stack">
        <h2 class="sec">GENERAL NOTES</h2>
        <ol class="notes">
          {profile.notes.map((n) => <li>{n}</li>)}
        </ol>
      </section>

      <section class="stack">
        <div class="sec-row">
          <h2 class="sec">PROJECTS — HARDWARE</h2>
          <p class="legend">
            {STATUS_ORDER.map((s) => <span>{STATUS_MARK[s]} {s}</span>)}
          </p>
        </div>
        <ProjectTable rows={hardware} />
      </section>

      {
        software.length > 0 && (
          <section class="stack">
            <h2 class="sec">PROJECTS — SOFTWARE AND HOMELAB</h2>
            <ProjectTable rows={software} />
          </section>
        )
      }

      <section class="stack">
        <h2 class="sec">EXPERIENCE</h2>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th scope="col" class="col-date">DATE</th>
                <th scope="col">DESCRIPTION</th>
              </tr>
            </thead>
            <tbody>
              {
                profile.experience.map((e) => (
                  <tr>
                    <td class="mono">{e.date}</td>
                    <td>
                      <p class="row-title">
                        {e.org} <span class="row-role">— {e.role}</span>
                      </p>
                      {e.detail && <p class="row-sub">{e.detail}</p>}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="stack">
        <h2 class="sec">SKILLS</h2>
        <div class="table-wrap">
          <table class="data skills">
            <tbody>
              {
                profile.skills.map((s) => (
                  <tr>
                    <th scope="row" class="col-skill">
                      {s.label}
                    </th>
                    <td>{s.items}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="note">
          Full history in the <a href="/resume.pdf">resume (PDF)</a>.
        </p>
      </section>
    </main>
  </div>
</Sheet>
